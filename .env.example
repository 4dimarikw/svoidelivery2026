APP_NAME="SvoiDelivery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# file-стор: локален для машины/контейнера. Если прод станет
# многосерверным — переезжать на redis (настройки ниже уже готовы), иначе
# инвалидация кеша (FilterOptionsRegistry::flush(), CategoryRegistry::flush())
# на одном узле не долетит до остальных.
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram bot credentials are NOT read from .env — the bot token lives in
# the telegraph_bots table (Domain\Telegram\Models\TelegramBot), provisioned
# via the stock `php artisan telegraph:new-bot`. See CLAUDE.md, "Telegram login".

VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# Защита форм входа/регистрации, config/security.php.
HONEYPOT_ENABLED=true
HONEYPOT_MIN_SECONDS=3
HONEYPOT_MAX_SECONDS=3600

REGISTER_THROTTLE_PER_IDENTITY=3
REGISTER_THROTTLE_PER_IP=10
REGISTER_THROTTLE_DECAY=10

PASSWORD_RESET_THROTTLE_PER_IDENTITY=3
PASSWORD_RESET_THROTTLE_PER_IP=10
PASSWORD_RESET_THROTTLE_DECAY=10

VERIFICATION_THROTTLE_PER_USER=6
VERIFICATION_THROTTLE_DECAY=1

PASSWORD_CONFIRM_THROTTLE_PER_USER=5
PASSWORD_CONFIRM_THROTTLE_DECAY=1

# Yandex SmartCaptcha. Выключена по умолчанию — включать только после того,
# как в storage/logs/security.log станет видно, что виджет реально грузится
# у пользователей (см. комментарий в config/security.php). SMART_CAPTCHA_SERVER_KEY
# секретный, в репозиторий не коммитить.
SMART_CAPTCHA_ENABLED=false
SMART_CAPTCHA_CLIENT_KEY=
SMART_CAPTCHA_SERVER_KEY=
SMART_CAPTCHA_TIMEOUT=2

LOG_SECURITY_LEVEL=info
LOG_SECURITY_DAYS=90
